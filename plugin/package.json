{
  "name": "tabby-claude-status",
  "version": "1.2.0",
  "description": "Visual tab indicators (color, emoji, progress, taskbar flash) and multi-backend TTS for Claude Code status inside Tabby terminal",
  "keywords": [
    "tabby-plugin",
    "claude",
    "claude-code",
    "terminal",
    "status",
    "tts",
    "edge-tts"
  ],
  "author": "Steven Prybylynskyi",
  "license": "MIT",
  "homepage": "https://github.com/steven-pribilinskiy/tabby-claude-status/tree/main/plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steven-pribilinskiy/tabby-claude-status.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/steven-pribilinskiy/tabby-claude-status/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "hook.js",
    "assets/",
    "online-sounds/",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "install-plugin": "npm run build && node scripts/install-plugin.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "msedge-tts": "^2.0.5"
  },
  "peerDependencies": {
    "@angular/common": ">=15.0.0",
    "@angular/core": ">=15.0.0",
    "@angular/forms": ">=15.0.0",
    "rxjs": "^7.0.0",
    "tabby-core": "*",
    "tabby-local": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/common": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.0",
    "@types/node": "^20.0.0",
    "rxjs": "^7.8.0",
    "tabby-core": "^1.0.163",
    "tabby-local": "^1.0.163",
    "tabby-settings": "^1.0.163",
    "tabby-terminal": "^1.0.163",
    "ts-loader": "^9.5.0",
    "typescript": "~4.9.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
