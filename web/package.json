{
	"name": "tabby-claude-status-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Web companion to the tabby-claude-status plugin: tab snapshot/restore + MCP tool explorer + hook event sink.",
	"scripts": {
		"dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
		"dev:server": "tsx watch src/server/index.ts",
		"build:client": "vite build",
		"typecheck": "tsgo --noEmit",
		"start": "tsx src/server/index.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.2",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"date-fns": "^4.1.0",
		"hono": "^4.12.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router-dom": "^7.13.1",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^25.6.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "beta",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.2.4",
		"tailwindcss": "^4.2.1",
		"tsx": "^4.21.0",
		"vite": "^8.0.3"
	}
}
